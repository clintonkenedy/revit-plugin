<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    Revit cannot run inside a test process, so this suite never executes add-in
    code. It proves what can be proved without the host: that the manifest Revit
    reads at startup says what the design requires, and that every class name it
    carries resolves in the assembly the build actually produced.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Metrado.Revit2027\Metrado.Revit2027.csproj" />
  </ItemGroup>

  <!--
    The add-in's types implement Revit interfaces, so reading them needs the
    Revit API metadata. The packages ship reference assemblies only, which never
    reach an output folder on their own; they are copied to RevitApi\ for
    MetadataLoadContext to read, and are never loaded for execution.
  -->
  <!--
    The Revit API is built against the Windows desktop runtime (WindowsBase,
    System.Drawing 10.0). Without this reference the build unifies those to
    the 4.0 compatibility facades and warns MSB3277.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.2.0" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.2.0" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgNice3point_Revit_Api_RevitAPI)\ref\net10.0-windows7.0\RevitAPI.dll" Link="RevitApi\RevitAPI.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgNice3point_Revit_Api_RevitAPIUI)\ref\net10.0-windows7.0\RevitAPIUI.dll" Link="RevitApi\RevitAPIUI.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    The add-in's own dependency manifest, which only its build writes. This
    suite's deps.json is not a substitute: the desktop runtime referenced above
    supplies System.IO.Packaging and drops it from this suite's graph, while
    the add-in, deployed on its own, has to carry it.

    It is taken from beside the add-in assembly this build actually copied,
    never from a spelled-out bin path: under another configuration or a
    redirected output (artifacts path) that path holds a stale file, and the
    suite would pin the closure against it.
  -->
  <Target Name="CopyAddInDependencyManifest" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_AddInAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'Metrado.Revit2027.dll'" />
      <_AddInDependencyManifest Include="@(_AddInAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
    </ItemGroup>
    <Error Condition="'@(_AddInDependencyManifest)' == '' Or !Exists('@(_AddInDependencyManifest)')" Text="Metrado.Revit2027.deps.json was not found beside the resolved add-in assembly '@(_AddInAssembly)'." />
    <Copy SourceFiles="@(_AddInDependencyManifest)" DestinationFolder="$(OutDir)AddIn" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
