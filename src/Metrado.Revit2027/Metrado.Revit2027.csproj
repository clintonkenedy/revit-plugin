<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Decision D3: the only project referencing the Revit API. It builds on
    macOS too: the API comes from NuGet reference assemblies, and
    net10.0-windows without WPF or WinForms cross-compiles. What needs the
    Windows host is running it inside Revit. Metrado.CrossPlatform.slnf
    leaves it out because the macOS loop does not need it, not because it
    cannot build there.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Reference assemblies only: Revit loads its own API binaries into the host
    process, so copying ours next to the add-in would risk a version clash.
    ExcludeAssets="runtime" is the PackageReference form of Private=false.
  -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.2.0" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.2.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The manifest travels with the assembly it registers. -->
  <ItemGroup>
    <None Include="Metrado.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metrado.Configuration\Metrado.Configuration.csproj" />
    <ProjectReference Include="..\Metrado.Domain\Metrado.Domain.csproj" />
    <ProjectReference Include="..\Metrado.Excel\Metrado.Excel.csproj" />
  </ItemGroup>

</Project>
